# Port for the Image Forge API
PORT=3010

# ComfyUI running on this computer makes the images (Phase B)
COMFYUI_URL=http://127.0.0.1:8188

# Web page allowed to call the API
FRONTEND_URL=http://localhost:5190

# Model file in ComfyUI's models/checkpoints folder
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# Where finished images are saved (default: backend/data/images)
# IMAGE_DATA_DIR=

# EOF Library API, used to fill in the cover form from a book
LIBRARY_API_URL=http://localhost:3002
