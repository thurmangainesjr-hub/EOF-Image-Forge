# Port for the Image Forge API
PORT=3010

# Which engine makes the pictures: replicate (cloud) or comfyui (needs an NVIDIA card).
# Leave it out and a Replicate key below means replicate.
# IMAGE_ENGINE=replicate

# Cloud images: your key from https://replicate.com/account/api-tokens
# Never share this key or put it on GitHub.
REPLICATE_API_TOKEN=
# Image model on Replicate (flux-schnell costs about $0.003 a picture)
REPLICATE_MODEL=black-forest-labs/flux-schnell

# ComfyUI on a computer with an NVIDIA graphics card
COMFYUI_URL=http://127.0.0.1:8188

# Web page allowed to call the API
FRONTEND_URL=http://localhost:5190

# Model file in ComfyUI's models/checkpoints folder
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# Where finished images are saved (default: backend/data/images)
# IMAGE_DATA_DIR=

# EOF Library API, used to fill in the cover form from a book
LIBRARY_API_URL=http://localhost:3002
